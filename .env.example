# apps/api — copy to .env at the repo root
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_IMAGE_BASE_URL=https://api.studio.nebius.ai/v1
MODEL_TEXT=deepseek-ai/DeepSeek-V4-Pro-0813
MODEL_TEXT_FALLBACK=nvidia/nemotron-3-super-120b-a12b
MODEL_VISION=google/gemma-3-27b-it
# Nebius image model. Alternatives commonly include stability-ai/sdxl if enabled in your Nebius catalog.
MODEL_IMAGE=black-forest-labs/flux-schnell
# fal (default when FAL_API_KEY is set) = Nano Banana Pro. nebius / svg = the older paths.
VISUAL_PROVIDER=auto
# full-card = the whole card is one generated image. background = image behind DOM copy.
VISUAL_MODE=full-card
FAL_API_KEY=
# nano-banana is ~4x cheaper; nano-banana-pro is sharper on type
FAL_MODEL=fal-ai/nano-banana
FAL_RESOLUTION=2K
IMAGE_SIZE=1024x1024
IMAGE_EXTENSION=webp
IMAGE_INFERENCE_STEPS=28
# IMAGE_SEED=123456
SLNG_API_KEY=
SLNG_STT_MODEL=deepgram/nova:3
BLOB_READ_WRITE_TOKEN=
PORT=8787
# 1 = replay recorded event streams, no LLM calls (no Nebius key needed)
MOCK=0
# mock-mode pacing: 1 = recorded timing, 0 = no delays
MOCK_SPEED=1

# apps/web — put in apps/web/.env.local
# NEXT_PUBLIC_API_URL=http://localhost:8787
